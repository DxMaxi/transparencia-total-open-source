# Frontend — URL pública da API, sem barra final
NEXT_PUBLIC_API_URL=http://localhost:8000
ADMIN_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: publique apenas um endereço institucional já operacional. Sem valor, o site não expõe email.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Identificação pública do responsável. Preencha no alojamento, nunca com placeholders.
NEXT_PUBLIC_LEGAL_RESPONSIBLE_NAME=
# Campos adicionais quando sejam aplicáveis à natureza jurídica/económica do responsável.
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_REGISTRATION=

# Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_API_KEY=trocar-por-um-segredo-longo-com-32-carateres
DATABASE_URL=postgresql://transparencia:desenvolvimento_local@localhost:5432/transparencia_total?schema=public
# URL pública do projeto Supabase; o backend usa-a apenas para validar JWT via JWKS.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=600
# Backend de ficheiros apenas para desenvolvimento, testes e reatestação histórica em staging.
# Os novos fluxos V4 persistentes guardam bytes em raw_source_objects no PostgreSQL.
RAW_ARCHIVE_ROOT=

# Recolha responsável de fontes oficiais
OFFICIAL_USER_AGENT=TransparenciaTotal/0.5 (+https://github.com/DxMaxi/transparencia-total-open-source; contacto: https://www.transparenciatotal.pt/contacto)
SOURCE_REQUESTS_PER_SECOND=0.5
SOURCE_MAX_BYTES=60000000
HTTP_TRUST_ENV=false
BASE_DATASET_CATALOG_URL=https://dados.gov.pt/api/1/datasets/66d72d488ca4b7cb2de28712/
# Opcional: recurso JSON/XML/ZIP oficial específico. Não use endpoints não autorizados.
BASE_RESOURCE_URL=
BASE_MAX_BYTES=200000000
BASE_MAX_UNCOMPRESSED_BYTES=750000000
# Segredo aleatório >=32 caracteres; permite HMAC de NIF individual sem o guardar em claro.
PROTECTED_IDENTIFIER_PEPPER=
OPEN_DATA_MAX_ROWS=10000
PARLAMENTO_DEPUTIES_URL=
PARLAMENTO_VOTES_URL=
PARLAMENTO_VOTES_MAX_BYTES=100000000
DRE_RSS_URL=

# IA — desligada por omissão; nunca exponha esta chave no frontend
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_STORE=false
AI_MAX_SOURCE_CHARS=220000
AI_CHUNK_CHARS=48000
AI_DAILY_GENERATION_LIMIT=20
AI_REQUEST_TIMEOUT_SECONDS=90

# Web Push — gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
