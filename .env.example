# Frontend — URL pública da API, sem barra final
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_API_KEY=trocar-por-um-segredo-longo-com-32-carateres
DATABASE_URL=postgresql://transparencia:desenvolvimento_local@localhost:5432/transparencia_total?schema=public

# Recolha responsável de fontes oficiais
OFFICIAL_USER_AGENT=TransparenciaTotal/0.3 (+https://github.com/SEU_UTILIZADOR/transparencia-total; contacto: dados@example.org)
SOURCE_REQUESTS_PER_SECOND=0.5
SOURCE_MAX_BYTES=60000000
HTTP_TRUST_ENV=false
BASE_DATASET_CATALOG_URL=https://dados.gov.pt/api/1/datasets/66d72d488ca4b7cb2de28712/
# Opcional: recurso JSON/XML/ZIP oficial específico. Não use endpoints não autorizados.
BASE_RESOURCE_URL=
BASE_MAX_BYTES=200000000
BASE_MAX_UNCOMPRESSED_BYTES=750000000
# Segredo aleatório >=32 caracteres; permite HMAC de NIF individual sem o guardar em claro.
PROTECTED_IDENTIFIER_PEPPER=
OPEN_DATA_MAX_ROWS=10000
PARLAMENTO_DEPUTIES_URL=
PARLAMENTO_VOTES_URL=
PARLAMENTO_VOTES_MAX_BYTES=100000000
DRE_RSS_URL=

# IA — desligada por omissão; nunca exponha esta chave no frontend
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_STORE=false

# Web Push — gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
